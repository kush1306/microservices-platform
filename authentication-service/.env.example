# Application
APP_NAME=Authentication Service
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1

# Database (SQLite for local development; use PostgreSQL in production)
DATABASE_URL=sqlite:///./auth.db
# DATABASE_URL=postgresql+psycopg2://auth_user:auth_password@localhost:5432/auth_db

# JWT
SECRET_KEY=change-me-to-a-long-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Security
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
