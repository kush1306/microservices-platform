
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    environment {
        AWS_REGION  = 'us-east-1'
        ECR_REGISTRY = '163885031975.dkr.ecr.us-east-1.amazonaws.com'
        EKS_CLUSTER = 'microservices-eks'
        SSH_USER    = 'ubuntu'
    }

    stages {

        // 1. CHECKOUT
        stage('Checkout') {
            steps {
                checkout scm
                echo 'Repository checked out successfully.'
            }
        }

        // 2. TERRAFORM
        stage('Terraform Init') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_ACCESS_KEY_PRIVATE', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir('terraform') {
                        sh 'terraform init'
                    }
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_ACCESS_KEY_PRIVATE', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir('terraform') {
                        sh 'terraform plan -out=tfplan'
                    }
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                withCredentials([
                    string(credentialsId: 'AWS_ACCESS_KEY', variable: 'AWS_ACCESS_KEY_ID'),
                    string(credentialsId: 'AWS_ACCESS_KEY_PRIVATE', variable: 'AWS_SECRET_ACCESS_KEY')
                ]) {
                    dir('terraform') {
                        sh 'terraform apply -auto-approve tfplan'
                    }
                }
            }
        }

        // 3. GET EC2 IP
        stage('Get EC2 Public IP') {
            steps {
                script {
                    env.EC2_PUBLIC_IP = sh(
                        script: 'cd terraform && terraform output -raw public_ip',
                        returnStdout: true
                    ).trim()

                    if (!env.EC2_PUBLIC_IP) {
                        error('Unable to retrieve EC2 public IP.')
                    }

                    echo "Remote build EC2: ${env.EC2_PUBLIC_IP}"
                }
            }
        }

        // 4. VERIFY EC2
        stage('Verify Remote EC2') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            -o ConnectTimeout=20 \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "echo CONNECTED && docker --version && aws --version && kubectl version --client && aws sts get-caller-identity"
                    '''
                }
            }
        }

        // 5. VERIFY EKS
        stage('Verify EKS Access') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER && kubectl get nodes"
                    '''
                }
            }
        }

        // 6. COPY PROJECT
        stage('Copy Project to EC2') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        tar czf project.tar.gz \
                            --exclude=.git \
                            --exclude=.env \
                            --exclude='*.db' \
                            --exclude='*.sqlite*' \
                            --exclude=.terraform \
                            --exclude=tfplan \
                            authentication-service \
                            user-service \
                            product-service \
                            inventory-service \
                            order-service \
                            notification-service \
                            kubernetes

                        scp -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            project.tar.gz \
                            "$SSH_USER@$EC2_PUBLIC_IP:/tmp/project.tar.gz"

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "mkdir -p ~/microservices-platform && tar xzf /tmp/project.tar.gz -C ~/microservices-platform && rm /tmp/project.tar.gz"

                        rm -f project.tar.gz
                    '''
                }
            }
        }

        // 7. BUILD IMAGES
        stage('Build Docker Images') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "BUILD_NUMBER='$BUILD_NUMBER' bash -s" <<'REMOTE'

                        set -e
                        cd ~/microservices-platform

                        for SERVICE in \
                            authentication-service \
                            user-service \
                            product-service \
                            inventory-service \
                            order-service \
                            notification-service
                        do
                            echo "Building $SERVICE"

                            docker build \
                                -t "$SERVICE:$BUILD_NUMBER" \
                                "./$SERVICE"
                        done

                        REMOTE
                    '''
                }
            }
        }

        // 8. ECR LOGIN
        stage('ECR Authentication') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY"
                    '''
                }
            }
        }

        // 9. PUSH IMAGES
        stage('Push Images to ECR') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "BUILD_NUMBER='$BUILD_NUMBER' ECR_REGISTRY='$ECR_REGISTRY' bash -s" <<'REMOTE'

                        set -e

                        for SERVICE in \
                            authentication-service \
                            user-service \
                            product-service \
                            inventory-service \
                            order-service \
                            notification-service
                        do
                            echo "Pushing $SERVICE"

                            docker tag \
                                "$SERVICE:$BUILD_NUMBER" \
                                "$ECR_REGISTRY/$SERVICE:$BUILD_NUMBER"

                            docker push "$ECR_REGISTRY/$SERVICE:$BUILD_NUMBER"

                        done

                        REMOTE
                    '''
                }
            }
        }

        // 10. APPLY STORAGE YAML FILES
        stage('Apply Kubernetes Storage') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "cd ~/microservices-platform && \
                             kubectl apply -f kubernetes/gp3-storageclass.yaml && \
                             kubectl apply -f kubernetes/microservices-pvc.yaml"
                    '''
                }
            }
        }

        // 11. DEPLOY APPLICATIONS
        stage('Deploy Kubernetes Services') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "cd ~/microservices-platform && kubectl apply -f kubernetes/k8s-deployment.yaml"
                    '''
                }
            }
        }

        // 12. UPDATE IMAGES
        stage('Update Kubernetes Images') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "BUILD_NUMBER='$BUILD_NUMBER' ECR_REGISTRY='$ECR_REGISTRY' bash -s" <<'REMOTE'

                        set -e

                        for SERVICE in \
                            authentication-service \
                            user-service \
                            product-service \
                            inventory-service \
                            order-service \
                            notification-service
                        do
                            echo "Updating $SERVICE"

                            kubectl set image \
                                deployment/$SERVICE \
                                $SERVICE=$ECR_REGISTRY/$SERVICE:$BUILD_NUMBER

                            kubectl rollout status \
                                deployment/$SERVICE \
                                --timeout=300s
                        done

                        REMOTE
                    '''
                }
            }
        }

        // 13. VERIFY RESOURCES
        stage('Verify Kubernetes Resources') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "kubectl get deployments,pods,services,pvc"
                    '''
                }
            }
        }

        // 14. HEALTH CHECKS
        stage('Microservices Health Checks') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        set -e

                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "bash -s" <<'REMOTE'

                        set -e

                        INDEX=0

                        for SERVICE in \
                            authentication-service \
                            user-service \
                            product-service \
                            inventory-service \
                            order-service \
                            notification-service
                        do
                            INDEX=$((INDEX + 1))
                            PORT=$((18080 + INDEX))
                            LOG="/tmp/pf-$SERVICE.log"

                            if [ "$SERVICE" = "authentication-service" ]; then
                                HEALTH_PATH="/api/v1/health"
                            else
                                HEALTH_PATH="/health"
                            fi

                            echo "Checking $SERVICE"

                            kubectl port-forward \
                                "svc/$SERVICE" "$PORT:8000" \
                                > "$LOG" 2>&1 &

                            PF_PID=$!

                            SUCCESS=0

                            for ATTEMPT in $(seq 1 15)
                            do
                                if curl -fsS \
                                    "http://127.0.0.1:$PORT$HEALTH_PATH"; then
                                    SUCCESS=1
                                    break
                                fi

                                sleep 2
                            done

                            kill "$PF_PID" 2>/dev/null || true
                            wait "$PF_PID" 2>/dev/null || true

                            if [ "$SUCCESS" -ne 1 ]; then
                                echo "Health check failed: $SERVICE"
                                cat "$LOG"
                                exit 1
                            fi

                            echo "$SERVICE health check passed."
                        done

                        REMOTE
                    '''
                }
            }
        }

        // 15. CLEANUP
        stage('Cleanup') {
            steps {
                withCredentials([
                    sshUserPrivateKey(
                        credentialsId: 'SSH-KEY',
                        keyFileVariable: 'SSH_KEY'
                    )
                ]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_PUBLIC_IP" \
                            "docker image prune -f"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: All six microservices deployed successfully.'
        }

        failure {
            echo 'FAILED: Check the Jenkins console output for the failing stage.'
        }

        always {
            echo 'Microservices pipeline execution completed.'
        }
    }
}
