
cd /tmp/microservices-platform-check

cat > jenkins/Jenkinsfile <<'EOF'
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        ECR_REGISTRY       = '163885031975.dkr.ecr.us-east-1.amazonaws.com'
        EKS_CLUSTER        = 'microservices-eks'
        EC2_IP             = '3.87.163.195'
        SSH_USER           = 'ubuntu'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Build EC2') {
            steps {
                withCredentials([
                    file(credentialsId: 'SSH-KEY', variable: 'SSH_KEY')
                ]) {
                    sh '''
                        chmod 600 "$SSH_KEY"

                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_IP" \
                            "docker --version && aws --version && kubectl version --client"
                    '''
                }
            }
        }

        stage('Copy Project to Build EC2') {
            steps {
                withCredentials([
                    file(credentialsId: 'SSH-KEY', variable: 'SSH_KEY')
                ]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_IP" \
                            "mkdir -p ~/microservices-platform"

                        scp -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=no \
                            -r authentication-service user-service \
                            product-service inventory-service \
                            order-service notification-service kubernetes \
                            "$SSH_USER@$EC2_IP:~/microservices-platform/"
                    '''
                }
            }
        }

        stage('Build and Push Images to ECR') {
            steps {
                withCredentials([
                    file(credentialsId: 'SSH-KEY', variable: 'SSH_KEY')
                ]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_IP" \
                            "bash -s -- '$ECR_REGISTRY' '$BUILD_NUMBER' '$AWS_DEFAULT_REGION'" <<'REMOTE'

set -euo pipefail

ECR_REGISTRY="$1"
IMAGE_TAG="$2"
AWS_REGION="$3"

cd ~/microservices-platform

echo "===== ECR LOGIN ====="

aws ecr get-login-password --region "$AWS_REGION" | \
    docker login --username AWS --password-stdin "$ECR_REGISTRY"

SERVICES="
authentication-service
user-service
product-service
inventory-service
order-service
notification-service
"

for SERVICE in $SERVICES; do
    echo "===== BUILDING $SERVICE ====="

    docker build \
        -t "$ECR_REGISTRY/$SERVICE:$IMAGE_TAG" \
        "./$SERVICE"

    docker tag \
        "$ECR_REGISTRY/$SERVICE:$IMAGE_TAG" \
        "$ECR_REGISTRY/$SERVICE:latest"

    echo "===== PUSHING $SERVICE ====="

    docker push "$ECR_REGISTRY/$SERVICE:$IMAGE_TAG"
    docker push "$ECR_REGISTRY/$SERVICE:latest"
done

echo "===== ALL SIX IMAGES PUSHED ====="

REMOTE
                    '''
                }
            }
        }

        stage('Connect to Existing EKS') {
            steps {
                withCredentials([
                    file(credentialsId: 'SSH-KEY', variable: 'SSH_KEY')
                ]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_IP" \
                            "aws eks update-kubeconfig \
                            --region '$AWS_DEFAULT_REGION' \
                            --name '$EKS_CLUSTER' && \
                            kubectl get nodes"
                    '''
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                withCredentials([
                    file(credentialsId: 'SSH-KEY', variable: 'SSH_KEY')
                ]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_IP" \
                            "bash -s -- '$ECR_REGISTRY' '$BUILD_NUMBER'" <<'REMOTE'

set -euo pipefail

ECR_REGISTRY="$1"
IMAGE_TAG="$2"

cd ~/microservices-platform

echo "===== APPLYING KUBERNETES MANIFESTS ====="

kubectl apply -f kubernetes/k8s-deployment.yaml

SERVICES="
authentication-service
user-service
product-service
inventory-service
order-service
notification-service
"

for SERVICE in $SERVICES; do
    echo "===== DEPLOYING $SERVICE:$IMAGE_TAG ====="

    # Recreate avoids overlapping pods using the same RWO EBS volume.
    kubectl patch deployment "$SERVICE" \
        --type=merge \
        -p '{"spec":{"strategy":{"type":"Recreate"}}}'

    kubectl set image \
        "deployment/$SERVICE" \
        "$SERVICE=$ECR_REGISTRY/$SERVICE:$IMAGE_TAG"

    kubectl rollout status \
        "deployment/$SERVICE" \
        --timeout=300s
done

echo "===== DEPLOYMENT COMPLETE ====="

REMOTE
                    '''
                }
            }
        }

        stage('Verify Deployments') {
            steps {
                withCredentials([
                    file(credentialsId: 'SSH-KEY', variable: 'SSH_KEY')
                ]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_IP" \
                            "kubectl get deployments,pods,services"
                    '''
                }
            }
        }

        stage('Verify Health Endpoints') {
            steps {
                withCredentials([
                    file(credentialsId: 'SSH-KEY', variable: 'SSH_KEY')
                ]) {
                    sh '''
                        ssh -i "$SSH_KEY" \
                            -o IdentitiesOnly=yes \
                            -o StrictHostKeyChecking=no \
                            "$SSH_USER@$EC2_IP" \
                            "bash -s" <<'REMOTE'

set -euo pipefail

SERVICES="
authentication-service
user-service
product-service
inventory-service
order-service
notification-service
"

for SERVICE in $SERVICES; do

    if [ "$SERVICE" = "authentication-service" ]; then
        HEALTH_PATH="/api/v1/health"
    else
        HEALTH_PATH="/health"
    fi

    echo "===== HEALTH CHECK: $SERVICE ====="

    kubectl port-forward "svc/$SERVICE" 18080:8000 \
        >/tmp/health-$SERVICE.log 2>&1 &

    PF_PID=$!
    HEALTHY=0

    for ATTEMPT in $(seq 1 20); do
        if curl -fsS "http://127.0.0.1:18080$HEALTH_PATH"; then
            HEALTHY=1
            break
        fi
        sleep 2
    done

    kill "$PF_PID" 2>/dev/null || true
    wait "$PF_PID" 2>/dev/null || true

    if [ "$HEALTHY" -ne 1 ]; then
        echo "Health check FAILED: $SERVICE"
        cat "/tmp/health-$SERVICE.log"
        exit 1
    fi

    echo
done

echo "===== ALL SIX SERVICES HEALTHY ====="

REMOTE
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: All six microservices deployed and verified on EKS.'
        }

        failure {
            echo 'FAILED: Check the stage logs to identify the deployment issue.'
        }
    }
}
EOF

echo "===== JENKINSFILE VALIDATION ====="
git diff --check

echo "===== JENKINSFILE CREATED ====="
wc -l jenkins/Jenkinsfile
