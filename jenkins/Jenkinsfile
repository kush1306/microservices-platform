
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        AWS_REGION  = 'us-east-1'
        ECR_REGISTRY = '163885031975.dkr.ecr.us-east-1.amazonaws.com'
        EKS_CLUSTER = 'microservices-eks'
        SSH_USER    = 'ubuntu'

        AWS_ACCESS_KEY_ID     = credentials('AWS_ACCESS_KEY')
        AWS_SECRET_ACCESS_KEY = credentials('AWS_ACCESS_KEY_PRIVATE')
        SSH_KEY               = credentials('SSH-KEY')
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                echo 'Source code checked out successfully.'
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Validate') {
            steps {
                dir('terraform') {
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }

        stage('Get EC2 Public IP') {
            steps {
                script {
                    env.EC2_PUBLIC_IP = sh(
                        script: 'cd terraform && terraform output -raw public_ip',
                        returnStdout: true
                    ).trim()

                    if (!env.EC2_PUBLIC_IP) {
                        error('Terraform did not return an EC2 public IP.')
                    }

                    echo "Build EC2: ${env.EC2_PUBLIC_IP}"
                }
            }
        }

        stage('Test EC2 Connectivity') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        -o ConnectTimeout=15 \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "echo SSH connection successful"
                '''
            }
        }

        stage('Check Build Environment') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "docker --version && aws --version && kubectl version --client"
                '''
            }
        }

        stage('Copy Project to EC2') {
            steps {
                sh '''
                    tar czf project.tar.gz \
                        --exclude=.git \
                        --exclude=.env \
                        --exclude='*.db' \
                        --exclude='*.sqlite*' \
                        --exclude=.terraform \
                        --exclude=tfplan \
                        authentication-service \
                        user-service \
                        product-service \
                        inventory-service \
                        order-service \
                        notification-service \
                        kubernetes

                    scp -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        project.tar.gz \
                        "$SSH_USER@$EC2_PUBLIC_IP:/tmp/project.tar.gz"

                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "mkdir -p ~/microservices-platform && tar xzf /tmp/project.tar.gz -C ~/microservices-platform && rm /tmp/project.tar.gz"

                    rm -f project.tar.gz
                '''
            }
        }

        stage('Build Docker Images') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "bash -s" <<'REMOTE'
                    set -e

                    cd ~/microservices-platform

                    for SERVICE in \
                        authentication-service \
                        user-service \
                        product-service \
                        inventory-service \
                        order-service \
                        notification-service
                    do
                        echo "Building $SERVICE"

                        docker build \
                            -t $SERVICE:$BUILD_NUMBER \
                            ./$SERVICE
                    done
                    REMOTE
                '''
            }
        }

        stage('ECR Authentication') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY"
                '''
            }
        }

        stage('Tag and Push Images to ECR') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "bash -s" <<'REMOTE'
                    set -e

                    for SERVICE in \
                        authentication-service \
                        user-service \
                        product-service \
                        inventory-service \
                        order-service \
                        notification-service
                    do
                        docker tag $SERVICE:$BUILD_NUMBER \
                            $ECR_REGISTRY/$SERVICE:$BUILD_NUMBER

                        docker tag $SERVICE:$BUILD_NUMBER \
                            $ECR_REGISTRY/$SERVICE:latest

                        docker push $ECR_REGISTRY/$SERVICE:$BUILD_NUMBER
                        docker push $ECR_REGISTRY/$SERVICE:latest
                    done
                    REMOTE
                '''
            }
        }

        stage('Configure EKS Access') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "aws eks update-kubeconfig --region $AWS_REGION --name $EKS_CLUSTER && kubectl get nodes"
                '''
            }
        }

        stage('Apply Kubernetes Storage') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "cd ~/microservices-platform && \
                         kubectl apply -f kubernetes/gp3-storageclass.yaml && \
                         kubectl apply -f kubernetes/microservices-pvc.yaml"
                '''
            }
        }

        stage('Deploy Kubernetes Services') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "cd ~/microservices-platform && kubectl apply -f kubernetes/k8s-deployment.yaml"
                '''
            }
        }

        stage('Update Kubernetes Images') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "bash -s" <<'REMOTE'
                    set -e

                    for SERVICE in \
                        authentication-service \
                        user-service \
                        product-service \
                        inventory-service \
                        order-service \
                        notification-service
                    do
                        kubectl set image deployment/$SERVICE \
                            $SERVICE=$ECR_REGISTRY/$SERVICE:$BUILD_NUMBER

                        kubectl rollout status deployment/$SERVICE \
                            --timeout=300s
                    done
                    REMOTE
                '''
            }
        }

        stage('Verify Kubernetes Resources') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "kubectl get deployments && kubectl get pods && kubectl get services && kubectl get pvc"
                '''
            }
        }

        stage('Verify Microservice Health') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "bash -s" <<'REMOTE'
                    set -e

                    for SERVICE in \
                        authentication-service \
                        user-service \
                        product-service \
                        inventory-service \
                        order-service \
                        notification-service
                    do
                        echo "Checking $SERVICE"

                        PORT=18080
                        LOG=/tmp/pf-$SERVICE.log

                        kubectl port-forward svc/$SERVICE $PORT:8000 > "$LOG" 2>&1 &
                        PF_PID=$!

                        SUCCESS=0

                        for ATTEMPT in $(seq 1 15)
                        do
                            if [ "$SERVICE" = "authentication-service" ]; then
                                PATH_CHECK="/api/v1/health"
                            else
                                PATH_CHECK="/health"
                            fi

                            if curl -fsS "http://127.0.0.1:$PORT$PATH_CHECK"; then
                                SUCCESS=1
                                break
                            fi

                            sleep 2
                        done

                        kill $PF_PID 2>/dev/null || true
                        wait $PF_PID 2>/dev/null || true

                        if [ "$SUCCESS" -ne 1 ]; then
                            echo "Health check failed: $SERVICE"
                            cat "$LOG"
                            exit 1
                        fi

                        echo "$SERVICE health check passed."
                    done
                    REMOTE
                '''
            }
        }

        stage('Cleanup Build Images') {
            steps {
                sh '''
                    ssh -i "$SSH_KEY" \
                        -o StrictHostKeyChecking=no \
                        "$SSH_USER@$EC2_PUBLIC_IP" \
                        "docker image prune -f"
                '''
            }
        }
    }

    post {
        success {
            echo 'SUCCESS: All six microservices deployed and health checks passed.'
        }

        failure {
            echo 'FAILED: Check the Jenkins console output for the failing stage.'
        }

        always {
            echo 'Pipeline execution completed.'
        }
    }
}
